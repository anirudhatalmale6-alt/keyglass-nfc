<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/setup_intro"
            android:textColor="@color/grey_text"
            android:textSize="14sp" />

        <!-- BASE CODE card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_frame_blue"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/base_code_header"
                android:textColor="@color/blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <EditText
                android:id="@+id/base_code"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:hint="@string/base_code_hint"
                android:textColorHint="@color/grey_icon"
                android:inputType="textVisiblePassword"
                android:maxLines="1"
                android:textColor="@color/blue"
                android:textSize="17sp"
                android:importantForAutofill="no" />

            <TextView
                android:id="@+id/btn_write"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_blue"
                android:gravity="center"
                android:text="@string/write_nfc_tag"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/mask_base_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/mask_base_code"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/write_protect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/write_protect"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/setup_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/grey_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- IDENTIFIERS card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_frame_green"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/identifiers_header"
                android:textColor="@color/green"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/btn_add"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_grey"
                android:gravity="center"
                android:text="@string/add_identifier"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
